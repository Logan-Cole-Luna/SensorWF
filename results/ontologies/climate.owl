<?xml version="1.0"?>
<rdf:RDF xmlns="https://sensorwf.org/ontologies/climate#"
         xml:base="https://sensorwf.org/ontologies/climate"
         xmlns:climate="https://sensorwf.org/ontologies/climate#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:ssn="http://www.w3.org/ns/ssn/"
         xmlns:sosa="http://www.w3.org/ns/sosa/">

  <owl:Ontology rdf:about="https://sensorwf.org/ontologies/climate">
    <rdfs:label>SensorWF Atmospheric Climate (Jena Climate Dataset) Ontology</rdfs:label>
    <rdfs:comment>Domain ontology auto-generated by SensorWF for Atmospheric Climate (Jena Climate Dataset). Classes link M3 features to domain concepts via the M4 knowledge graph.</rdfs:comment>
  </owl:Ontology>

  <owl:Class rdf:about="climate:SensorObservable">
    <rdfs:label>Sensor Observable</rdfs:label>
    <rdfs:comment>A physical quantity or subsystem observable by domain sensors.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:Temperature">
    <rdfs:label>Temperature</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: T_degC.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:PotentialTemperature">
    <rdfs:label>Potential Temperature</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: Tpot_K.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:DewPointTemperature">
    <rdfs:label>Dew Point Temperature</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: Tdew_degC.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:AtmosphericPressure">
    <rdfs:label>Atmospheric Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: p_mbar.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:RelativeHumidity">
    <rdfs:label>Relative Humidity</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: rh_pct.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:SpecificHumidity">
    <rdfs:label>Specific Humidity</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: sh_gkg.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:WaterVapourConcentration">
    <rdfs:label>Water Vapour Concentration</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: H2OC_mmolmol.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:SaturationVapourPressure">
    <rdfs:label>Saturation Vapour Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: VPmax_mbar.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:ActualVapourPressure">
    <rdfs:label>Actual Vapour Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: VPact_mbar.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:VapourPressureDeficit">
    <rdfs:label>Vapour Pressure Deficit</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: VPdef_mbar.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:AirDensity">
    <rdfs:label>Air Density</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: rho_gm3.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:WindSpeed">
    <rdfs:label>Wind Speed</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: wv_ms.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:MaxWindSpeed">
    <rdfs:label>Max Wind Speed</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: max_wv_ms.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:WindDirection">
    <rdfs:label>Wind Direction</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorObservable"/>
    <rdfs:comment>Channel keys: wd_deg.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:SensorFault">
    <rdfs:label>Sensor Fault</rdfs:label>
    <rdfs:comment>A failure or anomaly mode injectable into domain sensor data.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:ClimSensorDrift">
    <rdfs:label>Slow polynomial drift (sensor aging / fouling)</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: clim_sensor_drift.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:ClimStuckSensor">
    <rdfs:label>Channel frozen at pre-fault value (sensor failure)</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: clim_stuck_sensor.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:ClimSpikeBurst">
    <rdfs:label>Burst of amplitude spikes (electrical interference)</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: clim_spike_burst.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:ClimDropoutZero">
    <rdfs:label>Channel drops to zero (power loss to sensor)</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: clim_dropout_zero.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:ClimScaleError">
    <rdfs:label>Multiplicative calibration shift (recalibration error)</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: clim_scale_error.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="climate:ClimSignFlip">
    <rdfs:label>Channel sign inversion (wiring reversal)</rdfs:label>
    <rdfs:subClassOf rdf:resource="climate:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: clim_sign_flip.</rdfs:comment>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="climate:featureImportance">
    <rdfs:label>feature importance</rdfs:label>
    <rdfs:range rdf:resource="xsd:double"/>
    <rdfs:comment>IsolationForest mean split frequency for this feature.</rdfs:comment>
  </owl:DatatypeProperty>

</rdf:RDF>
