<?xml version="1.0"?>
<rdf:RDF xmlns="https://sensorwf.org/ontologies/ecg#"
         xml:base="https://sensorwf.org/ontologies/ecg"
         xmlns:ecg="https://sensorwf.org/ontologies/ecg#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:ssn="http://www.w3.org/ns/ssn/"
         xmlns:sosa="http://www.w3.org/ns/sosa/">

  <owl:Ontology rdf:about="https://sensorwf.org/ontologies/ecg">
    <rdfs:label>SensorWF Biomedical ECG (MIT-BIH Arrhythmia Database) Ontology</rdfs:label>
    <rdfs:comment>Domain ontology auto-generated by SensorWF for Biomedical ECG (MIT-BIH Arrhythmia Database). Classes link M3 features to domain concepts via the M4 knowledge graph.</rdfs:comment>
  </owl:Ontology>

  <owl:Class rdf:about="ecg:SensorObservable">
    <rdfs:label>Sensor Observable</rdfs:label>
    <rdfs:comment>A physical quantity or subsystem observable by domain sensors.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:MLII">
    <rdfs:label>MLII</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorObservable"/>
    <rdfs:comment>Channel keys: MLII.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:V5">
    <rdfs:label>V5</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorObservable"/>
    <rdfs:comment>Channel keys: V5.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:BaselineWander">
    <rdfs:label>Baseline Wander</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorObservable"/>
    <rdfs:comment>Channel keys: BaselineWander.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:ElectrodeDropout">
    <rdfs:label>Electrode Dropout</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorObservable"/>
    <rdfs:comment>Channel keys: ElectrodeDropout.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:EMGArtifact">
    <rdfs:label>EMGArtifact</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorObservable"/>
    <rdfs:comment>Channel keys: EMGArtifact.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:PowerLineInterference">
    <rdfs:label>Power Line Interference</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorObservable"/>
    <rdfs:comment>Channel keys: PowerLineInterference.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:SensorFault">
    <rdfs:label>Sensor Fault</rdfs:label>
    <rdfs:comment>A failure or anomaly mode injectable into domain sensor data.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:EcgBaselineWander">
    <rdfs:label>Sinusoidal baseline drift (respiration artifact)</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: ecg_baseline_wander.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:EcgElectrodeDropout">
    <rdfs:label>Lead zero-clamp (electrode disconnection)</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: ecg_electrode_dropout.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:EcgEmgBurst">
    <rdfs:label>High-frequency EMG noise burst (muscle artifact)</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: ecg_emg_burst.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:EcgPowerlineNoise">
    <rdfs:label>60 Hz sinusoidal interference (power line)</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: ecg_powerline_noise.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:EcgAmplitudeScale">
    <rdfs:label>Multiplicative amplitude scaling (amplifier error)</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: ecg_amplitude_scale.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ecg:EcgLeadInversion">
    <rdfs:label>Sign inversion of one lead (lead reversal)</rdfs:label>
    <rdfs:subClassOf rdf:resource="ecg:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: ecg_lead_inversion.</rdfs:comment>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="ecg:featureImportance">
    <rdfs:label>feature importance</rdfs:label>
    <rdfs:range rdf:resource="xsd:double"/>
    <rdfs:comment>IsolationForest mean split frequency for this feature.</rdfs:comment>
  </owl:DatatypeProperty>

</rdf:RDF>
