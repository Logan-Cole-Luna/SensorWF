<?xml version="1.0"?>
<rdf:RDF xmlns="https://sensorwf.org/ontologies/satellite#"
         xml:base="https://sensorwf.org/ontologies/satellite"
         xmlns:satellit="https://sensorwf.org/ontologies/satellite#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:ssn="http://www.w3.org/ns/ssn/"
         xmlns:sosa="http://www.w3.org/ns/sosa/">

  <owl:Ontology rdf:about="https://sensorwf.org/ontologies/satellite">
    <rdfs:label>SensorWF Satellite Telemetry (KISPE SATLL SCOTTI v2) Ontology</rdfs:label>
    <rdfs:comment>Domain ontology auto-generated by SensorWF for Satellite Telemetry (KISPE SATLL SCOTTI v2). Classes link M3 features to domain concepts via the M4 knowledge graph.</rdfs:comment>
  </owl:Ontology>

  <owl:Class rdf:about="satellit:SensorObservable">
    <rdfs:label>Sensor Observable</rdfs:label>
    <rdfs:comment>A physical quantity or subsystem observable by domain sensors.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:AttitudeDeterminationAndControlSubsystem">
    <rdfs:label>Attitude Determination And Control Subsystem</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorObservable"/>
    <rdfs:comment>Channel keys: ACCEL_, GYRO_, MAG_, SUN_, WHEEL_.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:ElectricalPowerSubsystem">
    <rdfs:label>Electrical Power Subsystem</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorObservable"/>
    <rdfs:comment>Channel keys: BATT_, COMMS_PWR, EXT_, OBC_PWR, PLAT_5V, PWR_, ... (9 keys total).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:ThermalControlSubsystem">
    <rdfs:label>Thermal Control Subsystem</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorObservable"/>
    <rdfs:comment>Channel keys: TEMP_ADCS, TEMP_BATTERY, TEMP_COMMS, TEMP_EPS, TEMP_PAYLOAD, TEMP_SOLAR, ... (8 keys total).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:OnBoardDataHandling">
    <rdfs:label>On Board Data Handling</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorObservable"/>
    <rdfs:comment>Channel keys: CMD_, FSW_, TEMP_BACKPLANE, TEMP_OBDH.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:CommunicationsSubsystem">
    <rdfs:label>Communications Subsystem</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorObservable"/>
    <rdfs:comment>Channel keys: COMMS_, FRAME_ERR, FREQ, RSSI, TX_.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:SensorFault">
    <rdfs:label>Sensor Fault</rdfs:label>
    <rdfs:comment>A failure or anomaly mode injectable into domain sensor data.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:T1ObdhRunaway">
    <rdfs:label>OBDH thermal runaway (sustained ramp)</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: T1_obdh_runaway.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:T2BoardThermalShock">
    <rdfs:label>Board thermal shock (rapid spike + recovery)</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: T2_board_thermal_shock.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:T3ThermalBiasDivergence">
    <rdfs:label>Thermal bias divergence across sensors</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: T3_thermal_bias_divergence.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:P1BusSagRecovery">
    <rdfs:label>Bus voltage sag and partial recovery</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: P1_bus_sag_recovery.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:P2SwitchingNoiseBurst">
    <rdfs:label>Switching noise burst on power rails</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: P2_switching_noise_burst.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:P3RailLatchup">
    <rdfs:label>Rail latchup (sudden drop to near-zero)</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: P3_rail_latchup.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:C1PacketGapJitter">
    <rdfs:label>Packet timing jitter / gap anomaly</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: C1_packet_gap_jitter.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:C2RssiFade">
    <rdfs:label>RSSI signal fade</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: C2_rssi_fade.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:C3FrameErrorAvalanche">
    <rdfs:label>Frame error count avalanche</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: C3_frame_error_avalanche.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:A1AccelPacketDropout">
    <rdfs:label>Accelerometer packet dropout (zeros burst)</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: A1_accel_packet_dropout.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:A2GyroClipping">
    <rdfs:label>Gyro output clipping at ADC rail</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: A2_gyro_clipping.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:A3MagFieldInversion">
    <rdfs:label>Magnetometer polarity inversion</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: A3_mag_field_inversion.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:A4ImuCorrelationBreak">
    <rdfs:label>IMU cross-sensor correlation breakdown</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: A4_imu_correlation_break.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:A5SunSensorBlinding">
    <rdfs:label>Sun sensor blinding (step saturation)</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: A5_sun_sensor_blinding.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:W1WheelRunaway">
    <rdfs:label>Reaction wheel runaway (unbounded spin-up)</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: W1_wheel_runaway.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:W2WheelStictionStop">
    <rdfs:label>Reaction wheel stiction / stop</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: W2_wheel_stiction_stop.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="satellit:CompoundThermalPowerFault">
    <rdfs:label>Simultaneous thermal + power rail fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="satellit:SensorFault"/>
    <rdfs:comment>SensorWF fault tag: COMPOUND_thermal_power_fault.</rdfs:comment>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="satellit:featureImportance">
    <rdfs:label>feature importance</rdfs:label>
    <rdfs:range rdf:resource="xsd:double"/>
    <rdfs:comment>IsolationForest mean split frequency for this feature.</rdfs:comment>
  </owl:DatatypeProperty>

</rdf:RDF>
