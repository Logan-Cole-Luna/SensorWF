<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/sensorwf/climate#"
         xml:base="https://example.org/sensorwf/climate"
         xmlns:clim="https://example.org/sensorwf/climate#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:ssn="http://www.w3.org/ns/ssn/"
         xmlns:sosa="http://www.w3.org/ns/sosa/">

  <!-- Ontology header -->
  <owl:Ontology rdf:about="https://example.org/sensorwf/climate">
    <rdfs:label>SensorWF Climate Domain Ontology</rdfs:label>
    <rdfs:comment>OWL ontology for the SensorWF atmospheric climate application domain.
    Covers meteorological variables, sensor types, and atmospheric fault conditions.
    Aligned with W3C SSN/SOSA observable property vocabulary.
    Data source: Jena Climate Dataset (Max Planck Institute for Biogeochemistry).</rdfs:comment>
  </owl:Ontology>

  <!-- ── Top-level observable property classes ──────────────────── -->

  <owl:Class rdf:about="clim:MeteorologicalObservable">
    <rdfs:label>Meteorological Observable Property</rdfs:label>
    <rdfs:comment>A physical atmospheric quantity measurable by a weather station sensor.</rdfs:comment>
  </owl:Class>

  <!-- ── Thermodynamic variables ────────────────────────────────── -->

  <owl:Class rdf:about="clim:Temperature">
    <rdfs:label>Temperature</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Atmospheric temperature. Jena feature: T_degC (°C).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:PotentialTemperature">
    <rdfs:label>Potential Temperature</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Potential temperature (Kelvin). Jena feature: Tpot_K.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:DewPointTemperature">
    <rdfs:label>Dew Point Temperature</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Dew point temperature (°C). Jena feature: Tdew_degC.</rdfs:comment>
  </owl:Class>

  <!-- ── Pressure variables ─────────────────────────────────────── -->

  <owl:Class rdf:about="clim:AtmosphericPressure">
    <rdfs:label>Atmospheric Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Station-level atmospheric pressure (mbar). Jena feature: p_mbar.</rdfs:comment>
  </owl:Class>

  <!-- ── Humidity variables ─────────────────────────────────────── -->

  <owl:Class rdf:about="clim:RelativeHumidity">
    <rdfs:label>Relative Humidity</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Relative humidity (%). Jena feature: rh_pct.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:SpecificHumidity">
    <rdfs:label>Specific Humidity</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Specific humidity (g/kg). Jena feature: sh_gkg.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:WaterVapourConcentration">
    <rdfs:label>Water Vapour Concentration</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Water vapour mole fraction (mmol/mol). Jena feature: H2OC_mmolmol.</rdfs:comment>
  </owl:Class>

  <!-- ── Vapour pressure variables ─────────────────────────────── -->

  <owl:Class rdf:about="clim:SaturationVapourPressure">
    <rdfs:label>Saturation Vapour Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Saturation vapour pressure (mbar). Jena feature: VPmax_mbar.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:ActualVapourPressure">
    <rdfs:label>Actual Vapour Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Actual vapour pressure (mbar). Jena feature: VPact_mbar.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:VapourPressureDeficit">
    <rdfs:label>Vapour Pressure Deficit</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Vapour pressure deficit (mbar). Jena feature: VPdef_mbar.</rdfs:comment>
  </owl:Class>

  <!-- ── Air density ────────────────────────────────────────────── -->

  <owl:Class rdf:about="clim:AirDensity">
    <rdfs:label>Air Density</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Density of moist air (g/m³). Jena feature: rho_gm3.</rdfs:comment>
  </owl:Class>

  <!-- ── Wind variables ────────────────────────────────────────── -->

  <owl:Class rdf:about="clim:WindSpeed">
    <rdfs:label>Wind Speed</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Horizontal wind speed (m/s). Jena feature: wv_ms.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:MaxWindSpeed">
    <rdfs:label>Maximum Wind Speed</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Maximum wind gust speed (m/s). Jena feature: max_wv_ms.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:WindDirection">
    <rdfs:label>Wind Direction</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:MeteorologicalObservable"/>
    <rdfs:comment>Wind direction in degrees (0-360). Jena feature: wd_deg.</rdfs:comment>
  </owl:Class>

  <!-- ── Sensor fault / anomaly classes ────────────────────────── -->

  <owl:Class rdf:about="clim:SensorFault">
    <rdfs:label>Meteorological Sensor Fault</rdfs:label>
    <rdfs:comment>A failure or degradation mode of a weather station sensor.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:SensorDrift">
    <rdfs:label>Sensor Drift</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:SensorFault"/>
    <rdfs:comment>Slow systematic drift in sensor readings (aging, fouling).
    SensorWF fault tag: clim_sensor_drift.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:StuckSensor">
    <rdfs:label>Stuck Sensor</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:SensorFault"/>
    <rdfs:comment>Sensor output frozen at a constant value (mechanical or electronic failure).
    SensorWF fault tag: clim_stuck_sensor.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:SpikeBurst">
    <rdfs:label>Spike Burst</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:SensorFault"/>
    <rdfs:comment>Burst of large-amplitude spikes from electrical interference.
    SensorWF fault tag: clim_spike_burst.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:SensorDropout">
    <rdfs:label>Sensor Dropout</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:SensorFault"/>
    <rdfs:comment>Sensor output drops to zero (power loss or communication failure).
    SensorWF fault tag: clim_dropout_zero.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:CalibrationError">
    <rdfs:label>Calibration Error</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:SensorFault"/>
    <rdfs:comment>Multiplicative scaling error from incorrect sensor calibration.
    SensorWF fault tag: clim_scale_error.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="clim:WiringReversal">
    <rdfs:label>Wiring Reversal</rdfs:label>
    <rdfs:subClassOf rdf:resource="clim:SensorFault"/>
    <rdfs:comment>Sign inversion from reversed sensor wiring.
    SensorWF fault tag: clim_sign_flip.</rdfs:comment>
  </owl:Class>

  <!-- ── Properties ────────────────────────────────────────────── -->

  <owl:DatatypeProperty rdf:about="clim:featureImportance">
    <rdfs:label>feature importance</rdfs:label>
    <rdfs:range rdf:resource="xsd:double"/>
    <rdfs:comment>IsolationForest mean split frequency for this meteorological feature.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:ObjectProperty rdf:about="clim:affectsVariable">
    <rdfs:label>affects variable</rdfs:label>
    <rdfs:domain rdf:resource="clim:SensorFault"/>
    <rdfs:range  rdf:resource="clim:MeteorologicalObservable"/>
  </owl:ObjectProperty>

</rdf:RDF>
